{
  "name": "wicklapse-extension",
  "version": "0.10.38",
  "description": "A local-first Chrome extension for turning Axiom and Fomo trades into animated replay videos.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "check": "npm run typecheck && npm test",
    "build": "npm run check && wxt build && node scripts/sync-unpacked.mjs",
    "public:audit": "node scripts/audit-public.mjs",
    "public:history-check": "node scripts/audit-public.mjs --history",
    "release:check": "npm run public:audit && npm run check && wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@wxt-dev/module-react": "^1.1.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wxt": "^0.21.4"
  }
}
